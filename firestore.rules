rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '68113833@dpu.ac.th' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // User Profiles
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 128
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.role in ['admin', 'operator', 'contributor'];
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isSignedIn() && (
        (isOwner(userId) && isValidUserProfile(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'department', 'updatedAt'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Food Waste Logs
    function isValidWasteLog(data) {
      return data.category in ['vegetable_fruit', 'meat_protein', 'grains_bakery', 'coffee_eggshell', 'mixed_scraps']
        && data.weightKg is number && data.weightKg >= 0 && data.weightKg <= 10000
        && data.sourceLocation is string && data.sourceLocation.size() <= 128
        && data.recordedByUid == request.auth.uid
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    match /wasteLogs/{wasteLogId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(wasteLogId) && isValidWasteLog(incoming());
      allow update: if isSignedIn() && (
        (existing().recordedByUid == request.auth.uid && isValidWasteLog(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['weightKg', 'category', 'moistureEstimate', 'targetBinId', 'notes', 'carbonOffsetKg'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (existing().recordedByUid == request.auth.uid || isAdmin());
    }

    // Compost Bins (Sensors & IoT telemetry)
    function isValidCompostBin(data) {
      return data.name is string && data.name.size() <= 128
        && data.capacityKg is number && data.capacityKg > 0
        && data.status in ['idle', 'processing', 'curing', 'maintenance'];
    }

    match /compostBins/{binId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(binId) && isValidCompostBin(incoming());
      allow update: if isSignedIn() && isValidCompostBin(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'currentWeightKg', 'status', 'temperatureC', 'moisturePct',
          'phLevel', 'aerationActive', 'heatingActive', 'currentBatchId', 'updatedAt', 'name'
        ]) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Fermentation Batches
    function isValidBatch(data) {
      return data.binId is string && data.binId.size() <= 128
        && data.inputWeightKg is number && data.inputWeightKg >= 0
        && data.status in ['loading', 'thermophilic', 'curing', 'completed', 'failed'];
    }

    match /batches/{batchId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(batchId) && isValidBatch(incoming());
      allow update: if isSignedIn() && isValidBatch(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'progressPct', 'estimatedEndAt', 'completedAt', 'expectedYieldKg', 'actualYieldKg'
        ]) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Fertilizer Outputs
    function isValidFertilizerOutput(data) {
      return data.batchId is string && data.batchId.size() <= 128
        && data.type in ['pellet', 'powder', 'liquid_bio']
        && data.quantityKg is number && data.quantityKg >= 0
        && data.qualityGrade in ['premium', 'standard', 'utility'];
    }

    match /fertilizerOutputs/{outputId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(outputId) && isValidFertilizerOutput(incoming());
      allow update: if isSignedIn() && isValidFertilizerOutput(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'quantityKg', 'qualityGrade', 'destination', 'notes', 'npkRating', 'moisturePct'
        ]) || isAdmin()
      );
      allow delete: if isAdmin();
    }
  }
}
